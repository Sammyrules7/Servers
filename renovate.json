{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/flake.nix",
    "**/flake.lock"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "flux": {
    "managerFilePatterns": [
      "/(^|/)cluster/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)cluster/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "flux",
        "kubernetes"
      ],
      "groupName": "Kubernetes dependencies"
    }
  ]
}
